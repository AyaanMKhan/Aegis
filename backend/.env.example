# Copy to .env and fill in. .env is gitignored; this file is not.

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). The registered redirect URI must be exactly:
#   http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From GitHub -> Settings -> Developer settings -> OAuth Apps. The
# Authorization callback URL must be exactly:
#   http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
